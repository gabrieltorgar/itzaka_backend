{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "develop": true
    }
  },
  "buildCommand": "uv sync --frozen --no-dev && uv run --no-sync python src/manage.py migrate --noinput",
  "functions": {
    "wsgi.py": {
      "excludeFiles": "{tests/**,src/**/tests/**,**/test_*.py,**/*_test.py,conftest.py,src/**/conftest.py,fixtures/**,src/**/fixtures/**,testdata/**,sample-data/**,docs/**,reports/**,coverage.xml,htmlcov/**,.coverage,.pytest_cache/**,.ruff_cache/**,node_modules/**,.github/**,**/*.md,scripts/test_gate.py}"
    }
  }
}
