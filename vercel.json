{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "develop": true
    }
  },
  "buildCommand": "uv sync --frozen --no-dev && uv run --no-sync python src/manage.py migrate --noinput && uv run --no-sync python src/manage.py createcachetable",
  "functions": {
    "wsgi.py": {
      "excludeFiles": "{**/tests/**,**/test_*.py,**/*_test.py,**/conftest.py,**/fixtures/**,docs/**,reports/**,htmlcov/**,coverage.xml,.coverage,.pytest_cache/**,.ruff_cache/**,node_modules/**,.github/**,*.md,scripts/test_gate.py}"
    }
  }
}
